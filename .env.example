NODE_ENV=development
PORT=3000
SKIP_KEYCLOAK=true

MONGODB_URI=mongodb://localhost:27017
DB_NAME=naya_overleaf

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost

SESSION_SECRET=naya-overleaf-dev-secret

KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=naya-overleaf
KEYCLOAK_CLIENT_ID=naya-overleaf-client

COMPILATION_DIR=./compilation
DOCKER_IMAGE=naya-overleaf-texlive

# AI Layer (Bring Your Own Key)
# Generate with: openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET=
# Generate with: openssl rand -base64 32
AI_INTERNAL_SECRET=
# URL for AI microservice (Docker internal)
AI_SERVICE_URL=http://ai-service:8000
# Enable/disable AI features
AI_ENABLED=true
