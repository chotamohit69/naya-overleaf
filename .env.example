NODE_ENV=development
PORT=3000
SKIP_KEYCLOAK=true

MONGODB_URI=mongodb://localhost:27017
DB_NAME=naya_overleaf

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000
RABBITMQ_URL=amqp://localhost
RABBITMQ_CONNECT_TIMEOUT_MS=3000
RABBITMQ_RECONNECT_DELAY_MS=1000

SESSION_SECRET=naya-overleaf-dev-secret

KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=naya-overleaf
KEYCLOAK_CLIENT_ID=naya-overleaf-client

COMPILATION_DIR=./compilation
DOCKER_IMAGE=naya-overleaf-texlive
COMPILATION_TIMEOUT_MS=120000
DOCKER_COMMAND_TIMEOUT_MS=30000
WORKER_HEALTH_PORT=3001

# AI Layer (Bring Your Own Key)
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET=
# At least 16 characters. Must match app and ai-service.
AI_INTERNAL_SECRET=
# URL for AI microservice (Docker internal)
AI_SERVICE_URL=http://localhost:8000
# Enable/disable AI features
AI_ENABLED=true
# Comma-separated browser origins allowed by ai-service CORS.
CORS_ORIGINS=http://localhost:3000
# Internal URL the AI service uses to read encrypted user keys.
APP_INTERNAL_URL=http://localhost:3000
# Optional model overrides for the AI service.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-1.5-pro
LLM_TIMEOUT_SECONDS=30
# AI service routes require X-AI-Internal-Secret or X-Internal-Secret.
# Browser clients should call a Node/backend proxy, not ai-service directly.
